# The app reads real environment variables. It does not load this file itself.
# Use it with:  set -a; . ./.env; set +a; make run

# One key turns on real stories. Without one the app plays an offline mock story.
OPENROUTER_API_KEY=
GEMINI_API_KEY=
OPENCODE_API_KEY=

# Any OpenAI-compatible proxy (the `custom` provider).
# BASE_URL=https://ai.naufal.work
# AUTH_TOKEN=

# Which backend to use: openrouter, gemini, opencode-go or custom. Empty picks whichever key is set.
# LLM_PROVIDER=opencode-go

# Optional
# MODELS=deepseek/deepseek-v4.1-flash-1017   (gemini-3.6-flash,gemini-3.5-flash on Gemini, longcat-2.5-free on OpenCode Go, gemini-3.8-flash on custom)
# PROVIDER=stepfun
# REASONING=low
# JUDGE=on
# ROOM_PASSPHRASE=
# MAX_GAMES_PER_HOUR=10
# PORT=8080
